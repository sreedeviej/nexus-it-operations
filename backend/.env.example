# Server
NODE_ENV=development
PORT=5000
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m

# Comma-separated browser origins permitted to call the API
CORS_ORIGINS=http://localhost:3000

# PostgreSQL. Use a dedicated application role in local development.
DATABASE_URL=postgresql://nexus_app:REPLACE_WITH_APP_PASSWORD@localhost:5432/nexus_dev?schema=public

# Used only by Prisma Migrate. Use a separate, empty, disposable database
# with no application data; never point this at a development or production DB.
SHADOW_DATABASE_URL=postgresql://nexus_migration_user:REPLACE_WITH_MIGRATION_PASSWORD@localhost:5432/nexus_prisma_shadow_disposable?schema=public
