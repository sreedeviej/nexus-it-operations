# Server
NODE_ENV=development
PORT=5000

# Comma-separated browser origins permitted to call the API
CORS_ORIGINS=http://localhost:3000

# PostgreSQL. Use a dedicated application role in local development.
DATABASE_URL=postgresql://nexus_app:REPLACE_WITH_APP_PASSWORD@localhost:5432/nexus_dev?schema=public

# Used only by Prisma Migrate in development. This database must stay disposable.
SHADOW_DATABASE_URL=postgresql://nexus_app:REPLACE_WITH_APP_PASSWORD@localhost:5432/nexus_shadow?schema=public
