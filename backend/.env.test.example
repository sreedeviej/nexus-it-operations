# Copy this file to .env.test and configure it for the dedicated test database.
# Never copy DATABASE_URL or secrets from the development .env file.
NODE_ENV=test
TEST_DATABASE_URL=postgresql://nexus_test_user:replace-me@127.0.0.1:5432/nexus_test?schema=public
# Required for the test runner's identity check. Use a separate disposable
# test shadow database, not the primary test database or any database with application data.
SHADOW_DATABASE_URL=postgresql://nexus_test_admin:replace-me@127.0.0.1:5432/nexus_test_shadow?schema=public
# Used only for read-only identity, database-existence, and permission checks.
TEST_DATABASE_ADMIN_URL=postgresql://nexus_test_admin:replace-me@127.0.0.1:5432/postgres
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
